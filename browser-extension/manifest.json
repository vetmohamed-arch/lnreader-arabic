{
  "manifest_version": 3,
  "name": "LNReader Web",
  "short_name": "LNReader",
  "version": "1.1.1",
  "description": "حمّل فصول الروايات من أي موقع واقرأها أوفلاين، مع ترجمة عربي وتصدير EPUB.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LNReader Web",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "tabs", "downloads", "contextMenus", "alarms", "notifications", "cookies"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116"
}
